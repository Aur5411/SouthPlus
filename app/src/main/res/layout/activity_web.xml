<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/np_bg"
    android:orientation="vertical">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/np_bar_height"
        android:background="@color/np_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/NpToolButton"
            android:contentDescription="@string/menu_home"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/np_text"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btnRefresh"
            style="@style/NpToolButton"
            android:contentDescription="@string/menu_refresh"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btnMore"
            style="@style/NpToolButton"
            android:contentDescription="@string/menu_settings"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/np_bar_line" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/np_progress"
        android:progressBackgroundTint="@android:color/transparent" />

    <!-- 内容区：网页 / 原生版块 -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/np_bg" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 错误页 -->
        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/np_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/net_error"
                android:textColor="@color/np_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/errorDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:gravity="center"
                android:text="@string/net_error_desc"
                android:textColor="@color/np_text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:minWidth="120dp"
                android:text="@string/retry"
                android:textColor="@color/np_accent" />

            <Button
                android:id="@+id/btnSwitchSite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:minWidth="160dp"
                android:text="@string/site_switch"
                android:textColor="@color/np_accent" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部导航（由代码填充，非主界面时隐藏） -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/np_bar_line" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/np_nav_height"
        android:background="@color/np_nav_bg"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
